{
  "description": "Checks the editor's tools at session start (silent when everything is installed; on a first run it tells Claude to open the editor's window before installing). Shows Claude's questions in the editor's window when it is open. Stops a Claude when Stop is pressed in the window, and records which skills each video ran. Tells the window when Claude waits for you in the Terminal.",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/skills/setup/scripts/setup.py\" doctor --quiet 2>/dev/null || py \"${CLAUDE_PLUGIN_ROOT}/skills/setup/scripts/setup.py\" doctor --quiet 2>/dev/null || true",
            "timeout": 20
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "AskUserQuestion",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/lib/ai_editor/askhook.py\" 2>/dev/null || py \"${CLAUDE_PLUGIN_ROOT}/lib/ai_editor/askhook.py\" 2>/dev/null || true",
            "timeout": 86400,
            "statusMessage": "Asking in the editor window"
          }
        ]
      },
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/lib/ai_editor/toolhook.py\" 2>/dev/null || py \"${CLAUDE_PLUGIN_ROOT}/lib/ai_editor/toolhook.py\" 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/lib/ai_editor/toolhook.py\" notify 2>/dev/null || py \"${CLAUDE_PLUGIN_ROOT}/lib/ai_editor/toolhook.py\" notify 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${CLAUDE_PLUGIN_ROOT}/lib/ai_editor/toolhook.py\" clear 2>/dev/null || py \"${CLAUDE_PLUGIN_ROOT}/lib/ai_editor/toolhook.py\" clear 2>/dev/null || true",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
